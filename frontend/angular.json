{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {"chat": {
    "projectType": "application", "root": "", "sourceRoot": "src",
    "architect": {
      "build": {
        "builder": "@angular/build:application",
        "options": {"browser": "src/main.ts", "tsConfig": "tsconfig.json", "index": "src/index.html", "styles": ["src/styles.css"], "outputPath": "dist/chat"},
        "configurations": {
          "production": {"outputHashing": "all", "budgets": [{"type": "initial", "maximumWarning": "600kB", "maximumError": "1MB"}]},
          "development": {"optimization": false, "sourceMap": true}
        }, "defaultConfiguration": "production"
      },
      "serve": {"builder": "@angular/build:dev-server", "configurations": {"development": {"buildTarget": "chat:build:development"}}, "defaultConfiguration": "development"}
    }
  }
},
"cli": {
  "analytics": "e767a460-61bb-4c7f-85ad-4f5d075f8f08"
}
}
